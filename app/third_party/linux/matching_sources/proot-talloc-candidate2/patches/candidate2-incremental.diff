+static void record_initial_tracee_status(pid_t pid, int wait_status)
+{
+	if (initial_tracee_status_recorded || pid != initial_tracee_pid)
+		return;
+
+	if (WIFEXITED(wait_status))
+		initial_tracee_exit_status = WEXITSTATUS(wait_status);
+	else if (WIFSIGNALED(wait_status))
+		initial_tracee_exit_status = 128 + WTERMSIG(wait_status);
+	else
+		return;
+
+	/* Latch before terminate_tracee() can SIGKILL background children. */
+	initial_tracee_status_recorded = true;
+}
