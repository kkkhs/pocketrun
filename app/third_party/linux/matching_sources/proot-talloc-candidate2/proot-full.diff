+
+	if (require_live_app_parent() != 0) {
+		fprintf(stderr, "fatal error: expected live App parent/PDEATHSIG required.\n");
+		return EXIT_FAILURE;
+	}
+
+	if (write_tracer_identity() != 0) {
+		fprintf(stderr, "fatal error: private tracer identity registration failed.\n");
+		return EXIT_FAILURE;
+	}
 
 	/* Configure the memory allocator.  */
 	talloc_enable_leak_report();
