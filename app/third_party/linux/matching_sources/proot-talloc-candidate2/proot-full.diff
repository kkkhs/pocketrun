+/* Pin the expected App parent before allocating or creating any child. */
+static int require_live_app_parent(void)
+{
+	const char *value = getenv("POCKETRUN_EXPECTED_PARENT_PID");
+	const char *p;
+	char *end;
+	long expected;
+
+	if (value == NULL || *value == '\0')
+		return -1;
+	for (p = value; *p != '\0'; p++) {
+		if (*p < '0' || *p > '9')
+			return -1;
+	}
+	errno = 0;
+	expected = strtol(value, &end, 10);
+	if (errno != 0 || *end != '\0' || expected <= 1 || expected > INT_MAX)
+		return -1;
+	if (prctl(PR_SET_PDEATHSIG, SIGKILL, 0L, 0L, 0L) != 0)
+		return -1;
+	/* This check closes death/reparenting before prctl took effect. */
+	return getppid() == (pid_t) expected ? 0 : -1;
+}
+
+/* Read field 22 without treating spaces or ')' inside comm as fields. */
+static int parse_self_start_ticks(char *stat_line, unsigned long long *ticks)
+{
+	char *cursor = strrchr(stat_line, ')');
+	int field;
+
+	if (cursor == NULL)
+		return -1;
+	cursor++;
+	for (field = 3; field <= 22; field++) {
+		char *token;
+		char *end;
+		char *p;
+		while (*cursor == ' ')
+			cursor++;
+		token = cursor;
+		while (*cursor != '\0' && *cursor != ' ' && *cursor != '\n')
+			cursor++;
+		if (cursor == token)
+			return -1;
+		if (field != 22)
+			continue;
+		for (p = token; p != cursor; p++) {
+			if (*p < '0' || *p > '9')
+				return -1;
+		}
+		*cursor = '\0';
+		errno = 0;
+		*ticks = strtoull(token, &end, 10);
+		return errno == 0 && *end == '\0' && *ticks != 0 ? 0 : -1;
+	}
+	return -1;
+}
+
+/* Optional App-owned registration, completed before the first guest exists. */
+static int write_tracer_identity(void)
+{
+	const char *path = getenv("POCKETRUN_TRACER_RECORD");
+	const char *slash;
+	char parent[PATH_MAX];
+	char stat_line[4096];
+	char record[256];
+	struct stat directory;
+	unsigned long long ticks;
+	size_t parent_length, offset = 0;
+	ssize_t count;
+	int dir_fd = -1, fd = -1, length, result = -1;
+
+	if (path == NULL)
+		return 0;
+	slash = strrchr(path, '/');
+	if (*path != '/' || slash == NULL || slash[1] == '\0' ||
+	    strcmp(slash + 1, ".") == 0 || strcmp(slash + 1, "..") == 0)
+		return -1;
+	parent_length = slash == path ? 1 : (size_t) (slash - path);
+	if (parent_length >= sizeof(parent))
+		return -1;
+	memcpy(parent, path, parent_length);
+	parent[parent_length] = '\0';
+	dir_fd = open(parent, O_RDONLY | O_DIRECTORY | O_NOFOLLOW | O_CLOEXEC);
+	if (dir_fd < 0 || fstat(dir_fd, &directory) != 0 ||
+	    directory.st_uid != getuid() || (directory.st_mode & 077) != 0)
+		goto out;
+
+	fd = open("/proc/self/stat", O_RDONLY | O_CLOEXEC);
+	if (fd < 0)
+		goto out;
+	do count = read(fd, stat_line, sizeof(stat_line) - 1); while (count < 0 && errno == EINTR);
+	if (close(fd) != 0) {
+		fd = -1;
+		goto out;
+	}
+	fd = -1;
+	if (count <= 0 || (size_t) count >= sizeof(stat_line) - 1)
+		goto out;
+	stat_line[count] = '\0';
+	if (parse_self_start_ticks(stat_line, &ticks) != 0)
+		goto out;
+	length = snprintf(record, sizeof(record),
+		"{\"schemaVersion\":1,\"pid\":%ld,\"ppid\":%ld,\"uid\":%lu,\"startTicks\":%llu}\n",
+		(long) getpid(), (long) getppid(), (unsigned long) getuid(), ticks);
+	if (length <= 0 || (size_t) length >= sizeof(record))
+		goto out;
+	fd = openat(dir_fd, slash + 1, O_WRONLY | O_CREAT | O_EXCL | O_NOFOLLOW | O_CLOEXEC, 0600);
+	if (fd < 0 || fchmod(fd, 0600) != 0)
+		goto out;
+	while (offset < (size_t) length) {
+		count = write(fd, record + offset, (size_t) length - offset);
+		if (count < 0 && errno == EINTR)
+			continue;
+		if (count <= 0)
+			goto out;
+		offset += (size_t) count;
+	}
+	if (fsync(fd) != 0)
+		goto out;
+	if (close(fd) != 0) {
+		fd = -1;
+		goto out;
+	}
+	fd = -1;
+	result = 0;
+out:
+	if (fd >= 0)
+		close(fd);
+	if (dir_fd >= 0 && close(dir_fd) != 0)
+		result = -1;
+	/* Do not pass the control-record path through the guest exec env. */
+	if (result == 0 && unsetenv("POCKETRUN_TRACER_RECORD") != 0)
+		result = -1;
+	return result;
+}
